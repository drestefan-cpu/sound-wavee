{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/shortcut",
      "destination": "/shortcut/index.html"
    },
    {
      "source": "/new",
      "destination": "/api/new"
    },
    {
      "source": "/s/:short",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|Googlebot|bingbot|Applebot|Embedly|Iframely|vkShare|Snapchat|Mastodon).*"
        }
      ],
      "destination": "/api/preview?short=:short"
    },
    {
      "source": "/song/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|Googlebot|bingbot|Applebot|Embedly|Iframely|vkShare|Snapchat|Mastodon).*"
        }
      ],
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/join/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|redditbot|SkypeUriPreview|Googlebot|bingbot|Applebot|Embedly|Iframely|vkShare|Snapchat|Mastodon).*"
        }
      ],
      "destination": "/api/preview?join=:username"
    },
    {
      "source": "/((?!api/|shortcut/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/shortcut/Share-with-PLAI.shortcut",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Share with PLAI.shortcut\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
